@page
@model csharp_oop_fundamentals.Pages.Cliente.ClienteModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="row justify-content-center g-4">

    @* ----- Formulário de cadastro ----- *@
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">Cadastrar Cliente</h4>
            </div>
            <form method="post">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">Nome do Cliente</label>
                        <input asp-for="Nome" class="form-control" placeholder="Digite o nome" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Endereco" class="form-label">Endereço</label>
                        <input asp-for="Endereco" class="form-control" placeholder="Rua, número, bairro" />
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">Sexo</legend>

                        <div class="form-check">
                            <input type="radio" asp-for="Sexo" value="M" id="masculino" class="form-check-input" />
                            <label for="masculino" class="form-check-label">Masculino</label>
                        </div>

                        <div class="form-check">
                            <input type="radio" asp-for="Sexo" value="F" id="feminino" class="form-check-input" />
                            <label for="feminino" class="form-check-label">Feminino</label>
                        </div>
                    </fieldset>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary w-100">Cadastrar Cliente</button>
                </div>
            </form>
        </div>
    </div>

    @* ----- Lista de clientes ----- *@
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Clientes cadastrados</h4>
                <span class="badge bg-secondary">@Model.Clientes.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Clientes.Count == 0)
                {
                    <p class="text-muted text-center my-4">Nenhum cliente cadastrado ainda.</p>
                }
                else
                {
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Nome</th>
                                <th scope="col">Endereço</th>
                                <th scope="col">Sexo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model.Clientes)
                            {
                                <tr>
                                    <td>@cliente.Id</td>
                                    <td>@cliente.Nome</td>
                                    <td>@cliente.Endereco</td>
                                    <td>@(cliente.Sexo == "M" ? "Masculino" : "Feminino")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>
