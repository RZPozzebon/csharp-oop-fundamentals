<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rod’s Pet - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/csharp_oop_fundamentals.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-wrapper">

        <aside class="sidebar">
            <a asp-area="" asp-page="/Index" class="sidebar-logo">
                <img src="~/img/rods-pet-logo.svg" alt="Rod’s Pet" />
            </a>

            <ul class="nav flex-column sidebar-menu">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/Index">
                        <i class="bi bi-house-door"></i> Início
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/Cliente/Cliente">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/Produto/Produto">
                        <i class="bi bi-box-seam"></i> Produtos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/FormaPagamento/FormaPagamento">
                        <i class="bi bi-credit-card"></i> Formas de Pagamento
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/Funcionario/Funcionario">
                        <i class="bi bi-person"></i> Funcionarios
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/FormaPagamento/FormaPagamento">
                        <i class="bi bi-door-closed-fill"></i> Sair
                    </a>
                </li>
            </ul>
        </aside>

        <div class="content-area">
            <main role="main" class="p-4">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - Rod’s Pet - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
