@page
@model csharp_oop_fundamentals.FormaPagamentoModel
@{
    ViewData[index: "title"] = "Formas de Pagamentos";
}

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h2>Forma de Pagamento</h2>
            </div>
            <form method="post" class="form-control">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label>Forma de Pagemento</label>
                    <input asp-for="NomeFormaPagamento" type="text" class="form-control mb-3"
                           placeholder="Digite o nome" />
                    <span asp-validation-for="NomeFormaPagamento" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 mb-3">Cadastrar Forma Pagamento</button>

                @* <button type="submit" class="btn btn-primary w-100">Cadatrar Produto</button> *@
            </form>
        </div>
    </div>

    @* ----- Lista de Formas de Pagamento ----- *@
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Formas de Pagamento</h4>
                <span class="badge bg-secondary">@Model.FormaPagamentoList.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.FormaPagamentoList.Count == 0)
                {
                    <p class="text-muted text-center my-4">Nenhuma forma de pagamento cadastra.</p>
                }
                else
                {
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Nome</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Pagamento in Model.FormaPagamentoList)
                            {
                                <tr>
                                    <td>@Pagamento.Id</td>
                                    <td>@Pagamento.NomeFormaPagamento</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" title="Excluir"
                                                aria-label="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}